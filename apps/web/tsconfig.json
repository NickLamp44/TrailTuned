{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@trailtuned/types": ["../../packages/types/src/index.ts"],
      "@trailtuned/utils": ["../../packages/utils/src/index.ts"],
      "@trailtuned/db": ["../../packages/db/src/index.ts"],
      "@trailtuned/strava": ["../../packages/strava/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/*/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
